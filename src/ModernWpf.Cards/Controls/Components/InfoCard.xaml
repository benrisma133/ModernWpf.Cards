<UserControl x:Class="ModernWpf.Cards.Controls.Components.InfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModernWpf.Cards.Controls.Components"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             Cursor="Hand"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ModernWpf.Cards;component/Themes/Styles/Buttons/CardActionButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform X="0" Y="0" />
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <!-- Entry animation: slides in from the right -->
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="400" To="0"
                                     Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <!-- Exit animation: slides out to the right -->
        <EventTrigger RoutedEvent="local:InfoCard.CloseClicked">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="400"
                                     Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseIn" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />

                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.3">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Border Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0: title -->
                <RowDefinition Height="*" />
                <!-- 1: description -->
                <RowDefinition Height="Auto" />
                <!-- 2: action buttons footer -->
                <RowDefinition Height="Auto" />
                <!-- 3: timer bar -->
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Icon background (supports ShowIcon) -->
            <Border x:Name="IconBorder"
                    Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    Background="{Binding IconBackground, ElementName=Root}"
                    Width="48" Height="48"
                    CornerRadius="10"
                    Margin="0,0,15,0"
                    VerticalAlignment="Top">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowIcon, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <fa:IconImage Icon="{Binding InfoIcon, ElementName=Root}"
                              Foreground="White"
                              Width="22" Height="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Border>

            <!-- 2. Title -->
            <TextBlock Grid.Row="0" Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding InfoTitle, ElementName=Root}"
                       Foreground="#F8FAFC"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>

            <!-- Close button -->
            <Button Grid.Row="0" Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-10,-5,0"
                    Cursor="Hand"
                    Foreground="#94A3B8"
                    Background="Transparent"
                    Click="CloseButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1AE53E3E" />
                                <Setter Property="Foreground" Value="#E53E3E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <fa:IconImage Icon="Times"
                              Width="12" Height="12"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>

            <!-- 3. Description -->
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding InfoDescription, ElementName=Root}"
                       Foreground="#94A3B8"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Margin="0,0,0,15"/>

            <!-- 4. Action buttons footer (hidden when there are no actions) -->
            <Border x:Name="ActionsFooter"
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Visibility="Collapsed"
                    Margin="0,0,0,15">
                <ItemsControl x:Name="ActionsList" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}"
                                    Style="{StaticResource CardActionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Click="ActionButton_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 5. Timer bar (bottom row) -->
            <Border x:Name="TimerBar"
                    Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Height="3"
                    Background="{Binding IconBackground, ElementName=Root}"
                    RenderTransformOrigin="0,0.5"
                    Margin="-20,0,-20,-20">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TimerScaleTransform" ScaleX="1"/>
                </Border.RenderTransform>
            </Border>

        </Grid>
    </Border>
</UserControl>